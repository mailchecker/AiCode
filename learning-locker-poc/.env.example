# Learning Locker POC 환경 설정 파일
# 이 파일을 .env로 복사하여 사용하세요: cp .env.example .env

# ===== 도메인 설정 =====
# Learning Locker가 실행될 도메인 (로컬 개발은 localhost)
DOMAIN_NAME=localhost

# ===== MongoDB 설정 =====
# MongoDB 루트 사용자 계정 정보
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123

# Learning Locker가 사용할 데이터베이스 이름
MONGO_DB=learninglocker

# ===== Redis 설정 =====
# Redis 인증 비밀번호
REDIS_PASSWORD=redis123

# ===== Learning Locker 애플리케이션 설정 =====
# 보안 키 (반드시 변경하세요! - 최소 32자 이상 권장)
APP_SECRET=your-super-secret-key-change-this-in-production-min-32-chars

# ===== SMTP 이메일 설정 (선택사항) =====
# 사용자 초대 및 알림 이메일 발송에 사용
# Gmail을 사용하는 경우:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURED=false

# SMTP 인증 정보 (이메일 기능을 사용하려면 입력)
SMTP_USER=
SMTP_PASS=

# 발신자 정보
SMTP_FROM_NAME=Learning Locker
SMTP_FROM_EMAIL=noreply@learninglocker.net

# ===== Learning Locker 관리자 계정 설정 =====
# 초기 설정 시 생성될 관리자 계정
SITE_URL=http://localhost

# 관리자 계정 정보
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_ORG_NAME=My Organization

# ===== xAPI Store 설정 =====
# 초기 생성될 LRS 스토어 정보
STORE_NAME=Default Store
STORE_DESCRIPTION=POC Test Store for xAPI Statements

# ===== 보안 설정 주의사항 =====
# 프로덕션 환경에서는 반드시 다음 값들을 강력한 암호로 변경하세요:
# - MONGO_ROOT_PASSWORD
# - REDIS_PASSWORD
# - APP_SECRET
# - ADMIN_PASSWORD
#
# 암호 생성 예시:
# openssl rand -base64 32
