# Learning Locker POC .gitignore

# 환경 설정 파일 (민감한 정보 포함)
.env

# Docker 볼륨 및 데이터
storage/
backups/*.tar.gz
backups/backup_*/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# 로그 파일
*.log
logs/

# OS 파일
.DS_Store
Thumbs.db

# IDE 설정
.vscode/
.idea/
*.swp
*.swo
*~

# 임시 파일
*.tmp
tmp/
temp/
